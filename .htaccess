RewriteEngine on
RewriteBase /hstspreloadhistory/

RewriteRule ^commit/([a-f0-9]+)/?$ commit-handler.php?commit=$1 [QSA,L]
RewriteRule ^domain/([a-z0-9.\-A-Z]+)/?$ host-handler.php?host=$1 [QSA,L]

<Files "hsts_history.db">
    Header set Cache-Control "max-age=2592000, public"
    Header set Content-Type "application/octet-stream"
    Header set Content-Disposition "attachment; filename*=UTF-8''HSTS-History.db"
</Files>
